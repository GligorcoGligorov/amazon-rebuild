# Neon Postgres. Copy from the Neon dashboard or `vercel env pull`.
# The app reads through the pooled URL.
DATABASE_URL=

# Unpooled connection, used by `pnpm db:migrate` and `pnpm db:seed` only.
# The pooler does not hold the session state DDL needs.
DATABASE_URL_UNPOOLED=

# Auth.js session signing key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
